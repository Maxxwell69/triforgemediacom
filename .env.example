# Database (Railway Postgres — use the public proxy URL for local dev; use the
# *.railway.internal URL only inside Railway itself, since that hostname only
# resolves from other services in the same Railway project)
#
# IMPORTANT: point this at your own local/dev/staging Postgres, never at the
# production database. `db:push`, `db:migrate`, and `db:seed` are local-only
# tools (migrate dev can reset data if it detects drift) — production always
# goes through `prisma migrate deploy`, which now runs automatically as part
# of `npm start`. See PROD_DB_HOST below for a tripwire against doing this by
# accident.
DATABASE_URL="postgresql://user:password@localhost:5432/trifirge?schema=public"

# Host (and port, if your DB provider shares one proxy hostname across
# multiple databases — Railway does, e.g. "sakura.proxy.rlwy.net:28726") of
# the PRODUCTION Postgres instance. No credentials, just host[:port]. Once
# set, running db:push / db:migrate / db:seed while DATABASE_URL points at
# this host gets blocked automatically (scripts/guardDb.ts) — a safety net
# for the day your local .env accidentally still has the prod connection
# string in it. Leave blank to disable the check (not recommended once real
# members are on the platform).
PROD_DB_HOST=""

# Redis (Railway — Socket.io adapter for real-time chat, MVP2+)
REDIS_URL="redis://default:password@localhost:6379"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
# Local dev value below; in production (Vercel) this is https://hub.triforgemedia.com
NEXTAUTH_URL="http://localhost:3000"

# Resend (all app emails — invites, welcome, password reset, streak reminders,
# badges/certificates, application alerts, admin broadcasts). Note: the
# onboarding@resend.dev sender works out of the box but is rate-limited and
# meant for testing — verify triforgemedia.com in the Resend dashboard and
# switch RESEND_FROM_EMAIL to an address on it before sending broadcasts at
# real member volume.
# Also add a DMARC TXT at _dmarc.triforgemedia.com (see DEPLOYMENT.md) so
# Gmail/Outlook are less likely to file hub mail as spam.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TriForge <noreply@triforgemedia.com>"

# OpenAI (powers the "Generate with AI" button on /admin/broadcast, which
# drafts announcement emails from a rough topic so nobody has to write copy
# by hand). Optional — the broadcast tool still works without it, just
# without the Generate button. Get a key at platform.openai.com.
OPENAI_API_KEY=""

# Shared secret for the daily streak-reminder cron endpoint
# (/api/cron/streak-reminders?secret=...). Point a Railway Cron Job, GitHub
# Actions scheduled workflow, or a free pinger (e.g. cron-job.org) at that URL
# once a day. Generate any random string.
CRON_SECRET=""

# App
# Local dev value below; in production (Vercel) this is https://hub.triforgemedia.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (image uploads — course thumbnails, etc.)
# Create a bucket + API token at dash.cloudflare.com > R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket — either the free r2.dev subdomain
# (Bucket > Settings > Public Access) or a custom domain, no trailing slash
R2_PUBLIC_URL=""
# Webinar screen-recording uploads use a browser → R2 presigned PUT. In the
# R2 bucket Settings → CORS Policy, allow PUT/GET/HEAD from your hub origins
# (e.g. https://hub.triforgemedia.com and the staging Railway URL), and include
# Content-Type in Allowed Headers.

# tik.tools (profile stats + live check by TikTok username — no OAuth).
# Create a key at https://tik.tools/login and set it here / in Vercel.
# user_profile requires Pro+ on tik.tools; check_alive works on lower tiers.
TIKTOOLS_API_KEY=""

# TikTok Login Kit (legacy OAuth — no longer used for hub stats; kept for
# optional reconnect flows). Create an app at developers.tiktok.com if needed.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# LiveKit Cloud (member webinars — WebRTC A/V). Create a project at
# cloud.livekit.io and paste the project URL + API key/secret here and in
# Railway. Never expose LIVEKIT_API_SECRET to the browser; tokens are minted
# server-side at POST /api/webinars/:id/token.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Obtainable Hub dry-run (feature/obtainable-hub-dry-run). Leave both unset on
# production so Hub 0 looks exactly as today.
# Comma-separated catalog ids to hide (staging only), e.g. tiktokInsights,ghlImport
HUB_DRY_RUN_HIDE=""
# Comma-separated emails allowed to open /superadmin (catalog stub). Empty = 404.
SUPERADMIN_EMAILS=""

# Stripe (hub shop Checkout). Prefer a restricted key (rk_…) over sk_live.
# Webhook endpoint: /api/shop/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
