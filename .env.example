# Database (Railway Postgres — use the public proxy URL for local dev / Vercel;
# use the *.railway.internal URL only for services also deployed on Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/trifirge?schema=public"

# Redis (Railway — Socket.io adapter for real-time chat, MVP2+)
REDIS_URL="redis://default:password@localhost:6379"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
# Local dev value below; in production (Vercel) this is https://hub.triforgemedia.com
NEXTAUTH_URL="http://localhost:3000"

# Resend (all app emails — invites, welcome, password reset, streak reminders,
# badges/certificates, application alerts, admin broadcasts). Note: the
# onboarding@resend.dev sender works out of the box but is rate-limited and
# meant for testing — verify triforgemedia.com in the Resend dashboard and
# switch RESEND_FROM_EMAIL to an address on it before sending broadcasts at
# real member volume.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TriForge <noreply@triforgemedia.com>"

# OpenAI (powers the "Generate with AI" button on /admin/broadcast, which
# drafts announcement emails from a rough topic so nobody has to write copy
# by hand). Optional — the broadcast tool still works without it, just
# without the Generate button. Get a key at platform.openai.com.
OPENAI_API_KEY=""

# Shared secret for the daily streak-reminder cron endpoint
# (/api/cron/streak-reminders?secret=...). Point a Railway Cron Job, GitHub
# Actions scheduled workflow, or a free pinger (e.g. cron-job.org) at that URL
# once a day. Generate any random string.
CRON_SECRET=""

# App
# Local dev value below; in production (Vercel) this is https://hub.triforgemedia.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (image uploads — course thumbnails, etc.)
# Create a bucket + API token at dash.cloudflare.com > R2 Object Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for the bucket — either the free r2.dev subdomain
# (Bucket > Settings > Public Access) or a custom domain, no trailing slash
R2_PUBLIC_URL=""

# TikTok Login Kit (OAuth — lets members connect their TikTok account so we
# can show real follower/like/video counts on their profile). Create an app
# at developers.tiktok.com, add the "Login Kit" product, request the
# user.info.basic + user.info.stats scopes, and register
# {NEXT_PUBLIC_APP_URL}/api/tiktok/callback as a redirect URI.
# Note: until TikTok approves your app for production, only TikTok accounts
# you've added as "target users" in the developer portal can connect.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
