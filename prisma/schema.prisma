generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Auth.js / NextAuth Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core identity ----------

enum UserRole {
  ADMIN
  MOD
  CREATOR
  MEMBER
  RECRUIT
}

enum UserStatus {
  PENDING_APPLICATION
  INVITED
  ACTIVE
  BANNED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String? // null until account is set up via invite
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole   @default(RECRUIT)
  status        UserStatus @default(PENDING_APPLICATION)
  mutedUntil    DateTime? // null = not muted; future timestamp = muted until then
  receivesAdminAlerts Boolean @default(true) // admins can opt out of notification emails (e.g. figurehead accounts)
  /// Community announcement emails from Admin → Broadcast. Transactional mail (invites, password reset, etc.) is unaffected.
  broadcastEmailsOptIn Boolean @default(true)
  hiddenFromDirectory Boolean @default(false) // excludes this account from /members (e.g. shared/figurehead admin logins)
  /// Admin-only flag: when true, CN group/tag text renders green instead of orange.
  effect          Boolean  @default(false)
  /// Admin toggle: member can use the personal task list (self-assigned only). Default on for everyone.
  personalTasksEnabled Boolean @default(true)
  failedLoginAttempts Int @default(0) // reset to 0 on any successful login
  lockedUntil   DateTime? // null = not locked; future timestamp = login blocked until then
  lastLoginAt   DateTime? // set on each successful credentials login (admin visibility)
  /// Set once on the first successful login — “came into the hub.”
  firstLoginAt  DateTime?
  lastSeenAt    DateTime? // heartbeat while the hub is open — drives online green dots
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts                   Account[]
  sessions                   Session[]
  application                Application?
  profile                    Profile?
  messages                   Message[]
  messageReactions           MessageReaction[]
  dailyTasks                 DailyTask[]
  xpEvents                   XPEvent[]
  reviewedApplications       Application[]          @relation("ReviewedBy")
  groupMemberships           GroupMember[]
  moderationActionsPerformed ModerationAction[]     @relation("ModeratorActions")
  moderationActionsReceived  ModerationAction[]     @relation("ModerationTargets")
  rewardRedemptions          RewardRedemption[]
  enrollments                Enrollment[]
  lessonProgress             LessonProgress[]
  quizAttempts               QuizAttempt[]
  userBadges                 UserBadge[]
  assignmentSubmissions      AssignmentSubmission[] @relation("SubmittedBy")
  assignmentReviews          AssignmentSubmission[] @relation("ReviewedBy")
  certificates               Certificate[]
  tiktokConnection           TikTokConnection?
  tiktokStatsSnapshot        TikTokStatsSnapshot?
  liveSessions               TikTokLiveSession[]
  tags                       UserTag[]
  passwordResetTokens        PasswordResetToken[]
  broadcastsCreated          Broadcast[]            @relation("BroadcastCreatedBy")
  broadcastsSent             Broadcast[]            @relation("BroadcastSentBy")
  ghlImport                  GhlImport?
  dmParticipations           DirectConversationParticipant[]
  directMessages             DirectMessage[]
  directMessageReactions     DirectMessageReaction[]
  dmConversationsCreated     DirectConversation[]   @relation("DmCreatedBy")
  dmAllowlistEntry           DmAllowedUser?
  webinarsHosted             Webinar[]              @relation("WebinarHost")
  webinarAttendances         WebinarAttendance[]
  webinarChatMessages        WebinarChatMessage[]
  webinarStageRequests       WebinarStageRequest[]
  channelReads               ChannelRead[]
  bugReports                 BugReport[]
  bugReportRead              BugReportRead?
  groupInvitesSent           GroupInvite[]          @relation("GroupInvitedBy")
  groupApplications          GroupApplication[]     @relation("GroupApplicant")
  groupApplicationsReviewed  GroupApplication[]     @relation("GroupAppReviewer")
  projectsCreated            Project[]              @relation("ProjectCreatedBy")
  projectMemberships         ProjectMember[]
  projectTasksCreated        ProjectTask[]          @relation("ProjectTaskCreatedBy")
  projectTasksAssigned       ProjectTask[]          @relation("ProjectTaskAssignee")
  calendarEventsCreated      CalendarEvent[]        @relation("CalendarEventCreatedBy")
  calendarEventAttendances   CalendarEventAttendee[]
  availabilitySlots          AvailabilitySlot[]
  calendarBookingsMade       CalendarBooking[]      @relation("CalendarBookingBooker")
  calendarBookingsHosted     CalendarBooking[]      @relation("CalendarBookingHost")
  bookingPage                BookingPage?
  appointmentsHosted         Appointment[]          @relation("AppointmentHost")
  personalTasks              PersonalTask[]
  shopOrders                 ShopOrder[]
  shopDownloadGrants         ShopDownloadGrant[]
  /// Stripe Customer id for hub shop checkout (one-time now; subscriptions later).
  stripeCustomerId           String?   @unique
  progressionProfile         ProgressionProfile?
  progressionCategoryXp      ProgressionCategoryXp[]
  progressionMissionCompletions ProgressionMissionCompletion[]
  clientHubsCreated          ClientHub[]
  progressionModuleCompletions ProgressionModuleCompletion[]
  progressionQuizAttempts    ProgressionQuizAttempt[]
  progressionCertsHeld       ProgressionCertificationHeld[]
  progressionSkillsUnlocked  ProgressionSkillUnlock[]
  progressionBadges          ProgressionBadgeGrant[]
  progressionCertReviews     ProgressionCertificationHeld[] @relation("ProgressionCertReviewer")
  progressionApplication     ProgressionApplication?
  progressionAppsReviewed    ProgressionApplication[] @relation("ProgressionAppReviewer")
  campaignsCreated           Campaign[]             @relation("CampaignCreatedBy")
  campaignRuns               CampaignRun[]
  hubNotifications           HubNotification[]
  supportTicketsRequested    SupportTicket[]        @relation("SupportTicketRequester")
  supportTicketsAssigned     SupportTicket[]        @relation("SupportTicketAssignee")
  supportTicketMessages      SupportTicketMessage[]
  supportTicketRead          SupportTicketRead?
  faqArticlesUpdated         FaqArticle[]           @relation("FaqArticleUpdatedBy")
}

// ---------- Application / invite flow ----------

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Application {
  id           String            @id @default(cuid())
  userId       String            @unique
  answers      Json // form responses: platform, socials, why you want in, etc.
  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewNotes  String?
  inviteToken  String?           @unique
  inviteTokenExpiresAt DateTime? // invite links expire; null means no token has been issued yet
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?

  // CN track: applicant clicked through from the thank-you page to request
  // to join the TriForge Creator Network on TikTok, and optionally pasted
  // back the invitation code TikTok gave them so we can finish linking them.
  tiktokNetworkRequested   Boolean   @default(false)
  tiktokNetworkRequestedAt DateTime?
  tiktokNetworkCode        String?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

// ---------- GoHighLevel migration import ----------
// One-time (repeatable) tool for bringing existing GHL contacts into the Hub
// as real accounts, in a trackable "holding pattern" until they actually
// respond to the migration invite by setting a password.

enum GhlImportStatus {
  PENDING // fetched from GHL, not yet invited (shouldn't normally persist in this state)
  INVITED // invite email sent, waiting on them to respond
  CONFIRMED // they set a password and logged in — fully migrated
  DECLINED // admin manually marked them as not moving over
}

model GhlImport {
  id           String          @id @default(cuid())
  ghlContactId String          @unique
  name         String?
  email        String
  phone        String?
  tagsRaw      String? // comma-joined GHL tags at time of import, kept for reference
  status       GhlImportStatus @default(PENDING)
  invitedAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime        @default(now())

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Profile (drives TikTask personalization) ----------

enum Platform {
  TIKTOK
  TWITCH
  YOUTUBE
  KICK
  INSTAGRAM
  OTHER
}

model Profile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  platform             Platform
  goals                Json // e.g. { growFollowers: true, consistentSchedule: true }
  bio                  String?
  socialLinks          Json? // { tiktok: "...", twitch: "..." }
  pinnedTiktokVideoUrl String? // a specific video to feature/embed on their profile
  // Private contact — visible to the member and admins only, never on /members
  phone                String?
  country              String? // ISO-ish code from apply form (e.g. "US", "CA")
  // Public display: false (default) = TikTok username; true = User.name
  showRealName         Boolean  @default(false)
  // Optional community username (account settings). Chat always uses TikTok nickname.
  username             String?
  streakCount          Int       @default(0)
  lastActiveAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([username])
}

// ---------- Chat core ----------

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  minRole     UserRole @default(MEMBER) // minimum role required to view/post
  createdAt   DateTime @default(now())

  messages Message[]
  reads    ChannelRead[]
  groups   Group[]   @relation("ChannelGroups")
}

/// Per-user read cursor for Discord-style channel unread badges.
model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId])
}

// ---------- Groups (spaces + ACL) ----------
// Evolved from access-control-only groups into member spaces with roles,
// invites, and applications. ACL rules still apply: attaching channels makes
// exception rooms visible to group members (see lib/groups.ts).
// The Home group (isHome=true) is the main hub space for default channels.

enum GroupJoinMode {
  INVITE_ONLY // admins/managers invite; no open apply
  APPLY       // members can request to join; managers/admins approve
  CLOSED      // no invites/applies (used for system Home until Phase B wiring)
}

enum GroupMemberRole {
  MANAGER // can manage members, invites, apps (admins always can)
  MOD     // can moderate within the group
  MEMBER
}

enum GroupApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Group {
  id                  String        @id @default(cuid())
  name                String        @unique
  description         String?
  color               String        @default("#FD4802")
  /// Optional square icon shown in group lists and the space switcher.
  imageUrl            String?
  grantsTikTaskAccess Boolean       @default(true)
  /// System main hub space. Only one row should have isHome=true.
  isHome              Boolean       @default(false)
  /// When false, hide from /groups and the space switcher rail (still usable for access/tags).
  showInList          Boolean       @default(true)
  /// When true, members can create group-scoped events on the hub calendar.
  canCreateEvents     Boolean       @default(false)
  joinMode            GroupJoinMode @default(INVITE_ONLY)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  members           GroupMember[]
  invites           GroupInvite[]
  applications      GroupApplication[]
  channels          Channel[]          @relation("ChannelGroups")
  courses           Course[]           @relation("CourseGroups")
  completionCourses Course[]           @relation("CourseCompletionGroup")
  projects          Project[]
  calendarEvents    CalendarEvent[]

  @@index([isHome])
  @@index([showInList])
}

model GroupMember {
  id      String          @id @default(cuid())
  userId  String
  groupId String
  role    GroupMemberRole @default(MEMBER)
  addedAt DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, role])
}

model GroupInvite {
  id          String    @id @default(cuid())
  groupId     String
  token       String    @unique
  /// Optional email lock — null means anyone with the link can accept (while logged in).
  email       String?
  invitedById String
  expiresAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("GroupInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model GroupApplication {
  id           String                 @id @default(cuid())
  groupId      String
  userId       String
  message      String?
  status       GroupApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())

  group      Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User  @relation("GroupApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("GroupAppReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([groupId, userId])
  @@index([groupId, status])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String   @default("")
  /// Admin-only chat image (R2 public URL under chat-attachments/).
  imageUrl  String?
  createdAt DateTime @default(now())
  /// Set when the author edits the message content (null = never edited).
  editedAt  DateTime?
  /// Discord-style reply pointer (not a full thread). Null if original was deleted.
  replyToId String?

  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplies")

  @@index([channelId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ---------- Direct messages (admin-led 1:1; all ADMINs can read all threads) ----------

model ChatSettings {
  id          String   @id @default("global")
  // Who may start a DM besides ADMIN (ADMIN always can).
  // ADMIN = admins only; ADMIN_AND_MOD = admins + mods; ALLOWLIST = admins + listed users.
  dmAccessMode String  @default("ADMIN")
  updatedAt   DateTime @updatedAt
}

model DmAllowedUser {
  userId    String   @id
  addedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DirectConversation {
  id          String   @id @default(cuid())
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User                            @relation("DmCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  @@index([updatedAt])
}

model DirectConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime @default(now())

  conversation DirectConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions    DirectMessageReaction[]

  @@index([conversationId, createdAt])
}

model DirectMessageReaction {
  id              String   @id @default(cuid())
  directMessageId String
  userId          String
  emoji           String
  createdAt       DateTime @default(now())

  directMessage DirectMessage @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([directMessageId, userId, emoji])
  @@index([directMessageId])
}

// Singleton row (fixed id "global") holding the current company-wide banner
// shown at the top of the member dashboard. isActive lets admins hide it
// without losing the last message they wrote.
model Announcement {
  id            String   @id @default("global")
  message       String
  imageUrl      String?
  videoUrl      String?
  isActive      Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// ---------- Company social links (admin-managed) ----------
// One row per platform — any admin can add/edit/clear these from
// /admin/social. Shown as "follow us" / share links on the member dashboard.

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

model CompanySocial {
  id        String         @id @default(cuid())
  platform  SocialPlatform @unique
  url       String
  updatedAt DateTime       @updatedAt
}

// ---------- TikTok OAuth (Login Kit) ----------
// A member connects their own TikTok account so we can show real, live
// follower/like/video stats on their profile. TikTok's public API has no
// endpoint for liking/commenting on behalf of a user — this is read-only
// identity + stats, nothing more.
model TikTokConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  openId                String
  displayName           String?
  avatarUrl             String?
  followerCount         Int?
  followingCount        Int?
  likesCount            Int?
  videoCount            Int?
  statsUpdatedAt        DateTime?
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- TikTok stats via tik.tools (no OAuth) ----------
// Cached profile counts + live status looked up by the member's TikTok
// username from Profile.socialLinks.tiktok. Independent of Login Kit.

model TikTokStatsSnapshot {
  id               String    @id @default(cuid())
  userId           String    @unique
  uniqueId         String
  /// Numeric TikTok user id from tik.tools user_profile (string to avoid JS precision loss).
  tiktokUserId     String?
  nickname         String?
  avatarUrl        String?
  verified         Boolean   @default(false)
  bio              String?
  /// Creator link-in-bio URL from TikTok (tik.tools).
  bioLink          String?
  /// TikTok link-risk score when provided by tik.tools.
  bioLinkRisk      Int?
  followerCount    Int       @default(0)
  followingCount   Int       @default(0)
  heartCount       Int       @default(0)
  videoCount       Int       @default(0)
  /// Diamond Rush class label when Ultra/Agency tier returns it (e.g. D5, A1).
  leagueLabel      String?
  leagueRegion     String?
  leagueRank       Int?
  isLive           Boolean   @default(false)
  liveTitle        String?
  liveViewerCount  Int?
  roomId           String?
  statsFetchedAt   DateTime?
  liveCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One detected TikTok LIVE window (opened when cron first sees isLive, closed when offline).
model TikTokLiveSession {
  id             String    @id @default(cuid())
  userId         String
  uniqueId       String
  roomId         String?
  title          String?
  startedAt      DateTime
  endedAt        DateTime?
  lastSeenLiveAt DateTime
  peakViewers    Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
}

// ---------- Password reset ----------
// Single-use, expiring tokens for the /forgot-password -> /reset-password
// flow. Old tokens for a user aren't deleted on new requests — they just
// expire naturally / get marked used, keeping this dead simple.

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Admin broadcast emails ----------
// A log of one-off announcement emails admins send to a chosen audience
// (all members, a tag, a group, or a single user). Kept for history/auditing
// — sending itself just loops Resend calls, no queue/worker needed at this
// volume.

enum BroadcastAudienceType {
  ALL_MEMBERS
  TAG
  GROUP
  SINGLE_USER
  NETWORK_TRACK
}

enum BroadcastStatus {
  DRAFT
  SENT
}

model Broadcast {
  id              String                @id @default(cuid())
  subject         String
  /// Plain text body used while drafting (paragraphs separated by blank lines).
  bodyText        String                @default("")
  /// Final HTML after send (empty while still a draft).
  bodyHtml        String                @default("")
  audienceType    BroadcastAudienceType
  audienceLabel   String // human-readable snapshot, e.g. "Tag: Gamer"
  audienceTagId   String?
  audienceGroupId String?
  audienceTrack   String? // "CN" | "MN"
  audienceEmail   String?
  recipientCount  Int                   @default(0)
  status          BroadcastStatus       @default(SENT)
  createdById     String
  sentById        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sentAt          DateTime?

  createdBy User  @relation("BroadcastCreatedBy", fields: [createdById], references: [id])
  sentBy    User? @relation("BroadcastSentBy", fields: [sentById], references: [id])

  @@index([status, updatedAt])
}

// ---------- Editable system email templates ----------
// Code in lib/email.ts remains the fallback default. When a row exists here,
// senders use subject + bodyHtml with {{placeholder}} interpolation instead.

model EmailTemplate {
  key           String   @id // e.g. "invite", "welcome"
  subject       String
  bodyHtml      String // inner body; wrapped in branded layout unless wrapsInLayout=false
  wrapsInLayout Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// ---------- Tags (searchable creator attributes) ----------
// Admin-managed labels members can be found by (e.g. "Live Host", "Gamer").
// selfAssignable controls whether members can add/remove it themselves from
// their account page, or whether it's admin-only (e.g. an official "CN"
// designation an admin grants, that members can't just give themselves).

model Tag {
  id             String   @id @default(cuid())
  name           String   @unique
  color          String   @default("#00D4FF")
  description    String?
  selfAssignable Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users UserTag[]
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
}

// ---------- TikTask ----------

model TaskTemplate {
  id        String    @id @default(cuid())
  platform  Platform?
  // null platform = applies to everyone regardless of platform
  goalKey   String? // matches a key inside Profile.goals, e.g. "growFollowers"
  taskText  String
  xpValue   Int       @default(10)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dailyTasks DailyTask[]
}

enum TaskStatus {
  PENDING
  DONE
  SKIPPED
}

model DailyTask {
  id          String     @id @default(cuid())
  userId      String
  templateId  String
  date        DateTime   @db.Date
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template TaskTemplate @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId, date])
  @@index([userId, date])
}

// ---------- XP (append-only log, not just a counter) ----------

enum XPSource {
  TASK_COMPLETION
  MANUAL_ADJUSTMENT
  REWARD_REDEMPTION
  REWARD_REFUND
  COURSE_COMPLETION
  SOCIAL_SHARE
  LESSON_COMPLETION
  QUIZ_PASS
  CERT_TIER
  SKILL_UNLOCK
  MISSION_COMPLETION
  STREAK_BONUS
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  source    XPSource
  refId     String? // e.g. the DailyTask id that triggered this
  note      String? // optional context, e.g. reason for a manual adjustment
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source, refId])
}

// ---------- Moderation ----------

enum ModerationActionType {
  MESSAGE_DELETED
  USER_MUTED
  USER_UNMUTED
}

model ModerationAction {
  id              String               @id @default(cuid())
  type            ModerationActionType
  moderatorId     String
  targetUserId    String?
  channelId       String?
  messageSnapshot String?
  reason          String?
  createdAt       DateTime             @default(now())

  moderator  User  @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  targetUser User? @relation("ModerationTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ---------- Rewards store ----------

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  costPoints  Int
  imageUrl    String?
  stock       Int? // null = unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  redemptions RewardRedemption[]
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model RewardRedemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  status      RedemptionStatus @default(PENDING)
  notes       String?
  redeemedAt  DateTime         @default(now())
  fulfilledAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([userId])
  @@index([rewardId])
}

// ---------- Learning Center (courses, lessons, quizzes, badges) ----------

model Course {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  thumbnailUrl       String?
  category           String?
  isPublished        Boolean  @default(false)
  order              Int      @default(0)
  /// Module/course completion bonus (all lessons + quiz). Default 100.
  xpReward           Int      @default(100)
  completionGroupId  String?
  certificateEnabled Boolean  @default(false)
  /// When on, completing this course (and passing its quiz) counts toward Creator Progression.
  progressionEnabled     Boolean @default(false)
  progressionCategoryId  String?
  progressionLevelId     String?
  /// Specialty track name (e.g. "Gamer"). Shown to members who chose that specialization.
  progressionSpecialty   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lessons         Lesson[]
  modules         Module[]
  enrollments     Enrollment[]
  badges          Badge[]
  certificates    Certificate[]
  quiz            Quiz?
  groups          Group[]       @relation("CourseGroups")
  completionGroup Group?        @relation("CourseCompletionGroup", fields: [completionGroupId], references: [id], onDelete: SetNull)
  progressionCategory ProgressionCategory? @relation(fields: [progressionCategoryId], references: [id], onDelete: SetNull)
  progressionLevel    ProgressionLevel?    @relation(fields: [progressionLevelId], references: [id], onDelete: SetNull)

  @@index([progressionSpecialty])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
}

model Lesson {
  id                  String    @id @default(cuid())
  courseId            String
  moduleId            String?
  title               String
  order               Int       @default(0)
  thumbnailUrl        String?
  videoUrl            String?
  audioUrl            String?
  htmlEmbed           String?
  content             String?
  dripDaysAfterEnroll Int?
  dripUnlockAt        DateTime?
  /// Points for completing this lesson (knowledge-only).
  xpValue             Int       @default(15)
  /// Extra points when the lesson has a practical exercise/assignment.
  exerciseXpBonus     Int       @default(10)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module     Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  assignment Assignment?
  progress   LessonProgress[]

  @@index([courseId, order])
  @@index([moduleId, order])
}

model Quiz {
  id             String   @id @default(cuid())
  courseId       String   @unique
  title          String
  passScore      Int      @default(70)
  /// Points for passing (meeting passScore).
  passXp         Int      @default(50)
  /// Extra points when the passing attempt is 100%.
  perfectXpBonus Int      @default(25)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTI_SELECT
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json
  correctAnswer Json
  order         Int          @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  quizId        String
  answers       Json
  score         Int
  passed        Boolean
  attemptNumber Int
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  courseId    String?
  createdAt   DateTime @default(now())

  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ---------- Assignments (file/link submission + admin review) ----------

model Assignment {
  id           String   @id @default(cuid())
  lessonId     String   @unique
  title        String
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  userId         String
  submissionUrl  String?
  submissionText String?
  status         SubmissionStatus @default(PENDING)
  feedback       String?
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("SubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
}

// ---------- Certificates ----------

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  certNumber String   @unique
  issuedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ---------- Member webinars (LiveKit Cloud) ----------

enum WebinarStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
}

/// Hub visibility for who can see/join a webinar (outside-network guests use invite links separately).
enum WebinarAudience {
  ALL
  CN
  MN
  ADMIN
}

enum WebinarParticipantRole {
  HOST
  SPEAKER
  AUDIENCE
}

enum StageRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model Webinar {
  id              String        @id @default(cuid())
  title           String
  description     String?
  scheduledAt     DateTime
  status          WebinarStatus @default(DRAFT)
  /// Who in the hub can see this webinar: all members, CN, MN, or admins only.
  audience        WebinarAudience @default(ALL)
  hostUserId      String
  /// Optional branded host photo shown on webinar cards / detail (not the User.image).
  hostAvatarUrl   String?
  livekitRoomName String        @unique
  /// When true, outsiders can register via the secure /w/[token] page (not hub members).
  externalSignupEnabled Boolean @default(false)
  /// Unguessable token for the public external signup / invite page.
  externalInviteToken   String? @unique
  /// Shared id for weekly series instances created together. Null = one-off.
  seriesId        String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  host           User                  @relation("WebinarHost", fields: [hostUserId], references: [id])
  attendances    WebinarAttendance[]
  chatMessages   WebinarChatMessage[]
  stageRequests  WebinarStageRequest[]
  recordings     WebinarRecording[]
  externalGuests WebinarGuest[]
  /// Hub calendar mirror for mass-audience webinars (see lib/calendar.ts).
  calendarEvent  CalendarEvent?
  appointment    Appointment?

  @@index([status, scheduledAt])
  @@index([audience, status, scheduledAt])
  @@index([seriesId])
}

/// Outside-network registrant for a webinar with external signup enabled.
/// Not a hub User — join is via personal joinToken only.
model WebinarGuest {
  id           String    @id @default(cuid())
  webinarId    String
  name         String
  email        String
  /// Personal secret used to open the guest access / room pages.
  joinToken    String    @unique
  /// Session role for LiveKit (audience by default; SPEAKER when invited on stage).
  role            WebinarParticipantRole @default(AUDIENCE)
  /// Blocks re-stage until host invites again (same idea as WebinarAttendance.forcedAudience).
  forcedAudience  Boolean                @default(false)
  /// Pending raise-hand; cleared when approved/denied or when they go on stage.
  stageRequestStatus StageRequestStatus?
  stageRequestedAt   DateTime?
  /// Webinar-scoped chat mute for outside guests; null = not muted.
  chatMutedUntil  DateTime?
  registeredAt DateTime  @default(now())
  joinedAt     DateTime?
  kickedAt     DateTime?

  webinar      Webinar             @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  chatMessages WebinarChatMessage[]

  @@unique([webinarId, email])
  @@index([webinarId])
  @@index([webinarId, stageRequestStatus])
}

model WebinarRecording {
  id        String   @id @default(cuid())
  webinarId String
  title     String?
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId, sortOrder])
}

model WebinarAttendance {
  id              String                 @id @default(cuid())
  webinarId       String
  userId          String
  role            WebinarParticipantRole @default(AUDIENCE)
  /// Optional photo for this session (people list / stage). Falls back to TikTok avatar.
  avatarUrl       String?
  joinedAt        DateTime               @default(now())
  leftAt          DateTime?
  /// When true, resolveParticipantRole keeps them AUDIENCE (blocks re-host / re-stage until cleared).
  forcedAudience  Boolean                @default(false)
  /// Webinar-scoped chat mute; null = not muted.
  chatMutedUntil  DateTime?
  /// Set when kicked from the live room; blocks rejoin until cleared or webinar ends.
  kickedAt        DateTime?

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
  @@index([webinarId])
}

model WebinarChatMessage {
  id        String    @id @default(cuid())
  webinarId String
  /// Hub member author — null when posted by an outside guest.
  userId    String?
  /// Outside-network guest author — null when posted by a hub member.
  guestId   String?
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  webinar Webinar      @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest   WebinarGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([webinarId, createdAt])
  @@index([guestId])
}

model WebinarStageRequest {
  id         String             @id @default(cuid())
  webinarId  String
  userId     String
  status     StageRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([webinarId, userId])
  @@index([webinarId, status])
}

// ---------- Bug reports (replaces free-form #bugs chat) ----------

enum BugReportStatus {
  REPORTED
  IN_PROGRESS
  FIXED
  COULD_NOT_REPRODUCE
}

enum BugReportPlatform {
  WEBSITE
  PHONE_IOS
  PHONE_ANDROID
  OTHER
}

model BugReport {
  id            String             @id @default(cuid())
  /// Public trackable ticket id (HB-0001). Auto-increments.
  ticketNumber  Int                @unique @default(autoincrement())
  title         String
  description   String
  status        BugReportStatus    @default(REPORTED)
  platform      BugReportPlatform  @default(WEBSITE)
  /// Page where the bug happened (optional).
  pageUrl       String?
  /// Optional screenshot hosted on R2.
  screenshotUrl String?
  /// When the bug was entered — admin-editable for credit / SLA timing.
  reportedAt    DateTime           @default(now())
  /// When it was marked fixed — admin-editable; drives time-to-fix.
  fixedAt       DateTime?
  adminNotes    String?
  reporterId    String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, reportedAt])
  @@index([reporterId])
  @@index([createdAt])
}

/// Per-user cursor for Hub Bug sidebar unread badge (new tickets since last visit).
model BugReportRead {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Support network (FAQ + tickets) ----------

enum SupportTicketStatus {
  OPEN
  WAITING_ON_MEMBER
  WAITING_ON_STAFF
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  MEMBERSHIP
  CONTENT
  OTHER
}

model FaqCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles FaqArticle[]

  @@index([published, sortOrder])
}

model FaqArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  categoryId  String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  updatedBy User?       @relation("FaqArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([categoryId, sortOrder])
  @@index([published, featured])
}

model SupportTicket {
  id             String                 @id @default(cuid())
  /// Public trackable ticket id (TF-0001). Auto-increments.
  ticketNumber   Int                    @unique @default(autoincrement())
  subject        String
  category       SupportTicketCategory  @default(OTHER)
  status         SupportTicketStatus    @default(OPEN)
  requesterId    String
  assigneeId     String?
  lastActivityAt DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  requester User                   @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?                  @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  SupportTicketMessage[]

  @@index([status, lastActivityAt])
  @@index([requesterId])
  @@index([assigneeId])
}

model SupportTicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Per-user cursor for Support sidebar unread badge.
model SupportTicketRead {
  id         String   @id @default(cuid())
  userId     String   @unique
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Projects (admin-assigned hub work — distinct from TikTask) ----------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  DONE
  ARCHIVED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ProjectStatus @default(PLANNING)
  /// Optional scope to a group space.
  groupId     String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group     Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  tasks     ProjectTask[]

  @@index([status])
  @@index([groupId])
}

/// Membership grants visibility. Members only see a project if they are a
/// ProjectMember and/or assigned to at least one ProjectTask.
model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  addedAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectTask {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      ProjectTaskStatus @default(TODO)
  assigneeId  String?
  createdById String
  dueAt       DateTime?
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?   @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User    @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([assigneeId])
}

// ---------- Personal tasks (member self-management; admin-gated) ----------

enum PersonalTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Private to-do items a member creates and assigns only to themselves.
model PersonalTask {
  id          String             @id @default(cuid())
  userId      String
  title       String
  notes       String?
  status      PersonalTaskStatus @default(TODO)
  dueAt       DateTime?
  category    String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, sortOrder])
  @@index([userId, category])
}

// ---------- Calendar / availability / booking ----------

enum CalendarEventKind {
  MEETING
  EVENT
  LIVE
  WEBINAR
  OTHER
}

enum CalendarEventVisibility {
  /// Visible to all active hub members.
  HUB
  /// Visible to members of groupId (required when GROUP).
  GROUP
  /// Visible only to creator + explicit attendees.
  PRIVATE
}

enum CalendarBookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum AvailabilityKind {
  /// Creator go-live window.
  LIVE
  /// Open for meeting booking.
  FREE
  /// Blocked / busy (not bookable).
  BUSY
}

model CalendarEvent {
  id          String                  @id @default(cuid())
  title       String
  description String?
  kind        CalendarEventKind       @default(EVENT)
  visibility  CalendarEventVisibility @default(HUB)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  groupId     String?
  createdById String
  /// When set, this row mirrors a mass-audience Webinar on the hub calendar.
  webinarId   String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  group     Group?                  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy User                    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  webinar   Webinar?                @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  attendees CalendarEventAttendee[]
  bookings  CalendarBooking[]

  @@index([startsAt])
  @@index([kind, startsAt])
  @@index([groupId])
}

model CalendarEventAttendee {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model AvailabilitySlot {
  id         String          @id @default(cuid())
  userId     String
  kind       AvailabilityKind @default(FREE)
  label      String?
  startsAt   DateTime
  endsAt     DateTime
  isBookable Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings CalendarBooking[]

  @@index([userId, startsAt])
  @@index([startsAt, endsAt])
}

/// Booking a FREE availability slot, or an RSVP-style booking tied to an event.
model CalendarBooking {
  id        String                @id @default(cuid())
  slotId    String?
  eventId   String?
  bookerId  String
  hostId    String?
  status    CalendarBookingStatus @default(PENDING)
  notes     String?
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  slot   AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  event  CalendarEvent?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booker User              @relation("CalendarBookingBooker", fields: [bookerId], references: [id], onDelete: Cascade)
  host   User?             @relation("CalendarBookingHost", fields: [hostId], references: [id], onDelete: SetNull)

  @@index([bookerId])
  @@index([hostId])
  @@index([slotId])
  @@index([eventId])
  @@index([startsAt])
}

// ---------- Calendly-style staff booking pages ----------

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

/// One shareable booking page per staff host (Account → Booking).
model BookingPage {
  id           String   @id @default(cuid())
  hostUserId   String   @unique
  slug         String   @unique
  title        String   @default("Book a meeting")
  description  String?
  timezone     String   @default("America/New_York")
  durationMins Int      @default(30)
  bufferMins   Int      @default(0)
  /// How many days ahead guests can book.
  aheadDays    Int      @default(14)
  isActive     Boolean  @default(true)
  /// Offer a 1-hour reminder email on the public booking form.
  remindHourBefore Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host         User                   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  weeklyWindows BookingWeeklyWindow[]
  meetingTypes  BookingMeetingType[]
  openSlots     BookingOpenSlot[]
  appointments  Appointment[]
}

/// Recurring weekly open hours in the host's timezone (minutes from local midnight).
model BookingWeeklyWindow {
  id            String @id @default(cuid())
  bookingPageId String
  /// 0 = Sunday … 6 = Saturday (local to BookingPage.timezone).
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int

  bookingPage BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)

  @@index([bookingPageId, dayOfWeek])
}

/// Host-defined bookable meeting (e.g. 15-min intro vs 60-min strategy).
model BookingMeetingType {
  id            String   @id @default(cuid())
  bookingPageId String
  title         String
  description   String?
  durationMins  Int
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookingPage  BookingPage   @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([bookingPageId, sortOrder])
}

/// One-off extra open hours beyond the weekly schedule (fill gaps).
model BookingOpenSlot {
  id            String   @id @default(cuid())
  bookingPageId String
  startsAt      DateTime
  endsAt        DateTime
  label         String?
  createdAt     DateTime @default(now())

  bookingPage BookingPage @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)

  @@index([bookingPageId, startsAt])
}

model Appointment {
  id            String            @id @default(cuid())
  bookingPageId String
  hostUserId    String
  meetingTypeId String?
  bookerName    String
  bookerEmail   String
  notes         String?
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(CONFIRMED)
  webinarId     String?           @unique
  cancelToken   String            @unique
  remindHourBefore Boolean        @default(true)
  reminderSentAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  bookingPage BookingPage         @relation(fields: [bookingPageId], references: [id], onDelete: Cascade)
  host        User                @relation("AppointmentHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  meetingType BookingMeetingType? @relation(fields: [meetingTypeId], references: [id], onDelete: SetNull)
  webinar     Webinar?            @relation(fields: [webinarId], references: [id], onDelete: SetNull)

  @@index([hostUserId, startsAt])
  @@index([bookingPageId, startsAt])
  @@index([bookerEmail])
  @@index([meetingTypeId])
}

// ---------- Shop (Hub 0 catalog; Shopify / Printify / Stripe plug in later) ----------

enum ShopProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ShopProductSource {
  NATIVE
  SHOPIFY
  PRINTIFY
}

enum ShopProductKind {
  PHYSICAL
  DIGITAL
}

enum ShopOrderStatus {
  PENDING
  PAID
  FULFILLING
  FULFILLED
  CANCELLED
  REFUNDED
}

/// Singleton per hub database (`id = "default"`). Tokens stay in env for Hub 0.
model ShopSettings {
  id                String   @id @default("default")
  name              String   @default("TriForge Shop")
  tagline           String?
  supportEmail      String?
  currency          String   @default("usd")
  isPublished       Boolean  @default(false)
  /// Comma-separated ISO country codes for physical Stripe Checkout shipping.
  shippingCountries String   @default("US,CA,GB,AU")
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?
  shopifyShopDomain String?
  printifyShopId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ShopProduct {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  status      ShopProductStatus @default(DRAFT)
  kind        ShopProductKind   @default(PHYSICAL)
  source      ShopProductSource @default(NATIVE)
  externalId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  images         ShopProductImage[]
  variants       ShopVariant[]
  files          ShopProductFile[]
  orderItems     ShopOrderItem[]
  downloadGrants ShopDownloadGrant[]

  @@index([status])
  @@index([source, externalId])
}

/// Paid digital file. Served via short-lived signed URLs, not the public CDN.
model ShopProductFile {
  id          String   @id @default(cuid())
  productId   String
  r2Key       String
  fileName    String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ShopDownloadGrant {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([userId])
}

model ShopProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}

model ShopVariant {
  id         String   @id @default(cuid())
  productId  String
  title      String   @default("Default")
  sku        String?
  priceCents Int
  inventory  Int?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    ShopProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems ShopOrderItem[]

  @@index([productId])
}

model ShopOrder {
  id                      String          @id @default(cuid())
  userId                  String
  status                  ShopOrderStatus @default(PENDING)
  currency                String          @default("usd")
  subtotalCents           Int             @default(0)
  totalCents              Int             @default(0)
  shippingName            String?
  shippingLine1           String?
  shippingLine2           String?
  shippingCity            String?
  shippingRegion          String?
  shippingPostal          String?
  shippingCountry         String?
  stripeCheckoutSessionId String?         @unique
  stripePaymentIntentId   String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          ShopOrderItem[]
  downloadGrants ShopDownloadGrant[]

  @@index([userId, createdAt])
  @@index([status])
}

model ShopOrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  title          String
  variantTitle   String
  quantity       Int
  unitPriceCents Int

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ShopVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ---------- Creator Progression (admin-editable ladder — no hardcoded tracks) ----------

enum ProgressionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProgressionRecurrence {
  ONE_TIME
  REPEATABLE
  DAILY
  WEEKLY
}

enum ProgressionMissionTier {
  MICRO
  STANDARD
  MILESTONE
  MAJOR
}

enum ProgressionUnlockKind {
  QUIZ_PASSED
  CATEGORY_XP
  ADMIN_REVIEW
}

enum ProgressionSkillUnlockKind {
  MANUAL
  LEVEL
  CATEGORY_XP
  CERTIFICATION
}

enum ProgressionBadgeTrigger {
  LEVEL
  MISSION
  CERTIFICATION
  SKILL
  STANDALONE
}

enum ProgressionMilestoneMode {
  ALL
  ANY
}

model ProgressionCategory {
  id               String             @id @default(cuid())
  name             String
  description      String?
  imageUrl         String?
  sortOrder        Int                @default(0)
  status           ProgressionStatus  @default(DRAFT)
  unlockAtLevelId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  unlockAtLevel   ProgressionLevel?             @relation("CategoryUnlockLevel", fields: [unlockAtLevelId], references: [id], onDelete: SetNull)
  missions        ProgressionMission[]
  modules         ProgressionLearningModule[]
  certifications  ProgressionCertification[]
  skills          ProgressionSkill[]
  categoryXp      ProgressionCategoryXp[]
  courses         Course[]
}

model ProgressionLevel {
  id             String                   @id @default(cuid())
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int                      @default(0)
  xpRequired     Int                      @default(0)
  milestoneMode  ProgressionMilestoneMode @default(ALL)
  status         ProgressionStatus        @default(DRAFT)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  milestones          ProgressionLevelMilestone[]
  certRequirements    ProgressionLevelCertReq[]
  skills              ProgressionSkill[]
  profiles            ProgressionProfile[]
  adminPlacedProfiles ProgressionProfile[]        @relation("AdminPlacedLevel")
  unlocksCategories   ProgressionCategory[]       @relation("CategoryUnlockLevel")
  courses             Course[]
}

model ProgressionLevelMilestone {
  id        String @id @default(cuid())
  levelId   String
  missionId String

  level   ProgressionLevel   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  mission ProgressionMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([levelId, missionId])
}

model ProgressionLevelCertReq {
  id              String  @id @default(cuid())
  levelId         String
  certificationId String
  tierId          String?

  level          ProgressionLevel          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  certification  ProgressionCertification  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  tier           ProgressionCertTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([levelId, certificationId])
}

model ProgressionMission {
  id          String                 @id @default(cuid())
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  xpValue     Int                    @default(0)
  tier        ProgressionMissionTier @default(STANDARD)
  recurrence  ProgressionRecurrence  @default(ONE_TIME)
  sortOrder   Int                    @default(0)
  status      ProgressionStatus      @default(DRAFT)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  category    ProgressionCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  milestones  ProgressionLevelMilestone[]
  completions ProgressionMissionCompletion[]
}

model ProgressionLearningModule {
  id          String            @id @default(cuid())
  categoryId  String
  title       String
  description String?
  content     String?
  videoUrl    String?
  linkUrl     String?
  imageUrl    String?
  sortOrder   Int               @default(0)
  status      ProgressionStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  category    ProgressionCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  quiz        ProgressionQuiz?
  completions ProgressionModuleCompletion[]
}

model ProgressionQuiz {
  id              String @id @default(cuid())
  moduleId        String @unique
  passThreshold   Int    @default(70)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module    ProgressionLearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions ProgressionQuizQuestion[]
  attempts  ProgressionQuizAttempt[]
}

model ProgressionQuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  prompt       String
  options      Json
  correctIndex Int
  sortOrder    Int    @default(0)

  quiz ProgressionQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, sortOrder])
}

model ProgressionCertification {
  id          String            @id @default(cuid())
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int               @default(0)
  status      ProgressionStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  category         ProgressionCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tiers            ProgressionCertTier[]
  levelReqs        ProgressionLevelCertReq[]
  skills           ProgressionSkill[]
  held             ProgressionCertificationHeld[]
}

model ProgressionCertTier {
  id          String @id @default(cuid())
  certificationId String
  name        String
  description String?
  sortOrder   Int    @default(0)
  unlockKind  ProgressionUnlockKind @default(CATEGORY_XP)
  xpRequired  Int?
  /// Hub XP awarded the moment this tier is earned.
  xpAward     Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certification ProgressionCertification      @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  held          ProgressionCertificationHeld[]
  levelReqs     ProgressionLevelCertReq[]
  skillGates    ProgressionSkill[]

  @@index([certificationId, sortOrder])
}

model ProgressionSkill {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  imageUrl        String?
  sortOrder       Int                       @default(0)
  status          ProgressionStatus         @default(DRAFT)
  unlockKind      ProgressionSkillUnlockKind @default(MANUAL)
  levelId         String?
  categoryId      String?
  certificationId String?
  certTierId      String?
  xpRequired      Int?
  /// Hub XP awarded when this skill is unlocked (specialties default 200).
  xpAward         Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  level          ProgressionLevel?          @relation(fields: [levelId], references: [id], onDelete: SetNull)
  category       ProgressionCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  certification  ProgressionCertification?  @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  certTier       ProgressionCertTier?       @relation(fields: [certTierId], references: [id], onDelete: SetNull)
  unlocks        ProgressionSkillUnlock[]
}

model ProgressionBadge {
  id          String                   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  trigger     ProgressionBadgeTrigger  @default(STANDALONE)
  triggerId   String?
  status      ProgressionStatus        @default(DRAFT)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  grants ProgressionBadgeGrant[]
}

model ProgressionSettings {
  id                  String   @id @default("default")
  /// When false, Progress is hidden from CN and MN until training is ready.
  memberVisible       Boolean  @default(false)
  explainerVideoUrl   String?
  explainerHeadline   String   @default("Creator Progression")
  explainerBody       String?
  streak3Xp           Int      @default(25)
  streak7Xp           Int      @default(75)
  streak30Xp          Int      @default(300)
  microDailyCap       Int      @default(50)
  standardDailyCap    Int      @default(100)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum ProgressionApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// MN (and anyone not auto-enrolled) applies here before joining the ladder.
model ProgressionApplication {
  id           String                         @id @default(cuid())
  userId       String                         @unique
  whyJoin      String
  goals        String?
  status       ProgressionApplicationStatus   @default(PENDING)
  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProgressionAppReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ProgressionProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  currentLevelId     String?
  /// Admin placement floor — auto-eval will not drop them below this rank.
  adminPlacedLevelId String?
  /// Set when the member is on the ladder (CN signup or MN approved as Recruit).
  enrolledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel     ProgressionLevel?  @relation(fields: [currentLevelId], references: [id], onDelete: SetNull)
  adminPlacedLevel ProgressionLevel?  @relation("AdminPlacedLevel", fields: [adminPlacedLevelId], references: [id], onDelete: SetNull)
}

model ProgressionCategoryXp {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  amount     Int    @default(0)
  updatedAt  DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ProgressionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model ProgressionMissionCompletion {
  id         String   @id @default(cuid())
  userId     String
  missionId  String
  xpAwarded  Int
  completedAt DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission ProgressionMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([userId, missionId])
}

model ProgressionModuleCompletion {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime @default(now())

  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  module ProgressionLearningModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model ProgressionQuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz ProgressionQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
}

model ProgressionCertificationHeld {
  id              String   @id @default(cuid())
  userId          String
  certificationId String
  tierId          String
  reviewedById    String?
  awardedAt       DateTime @default(now())

  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification ProgressionCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  tier          ProgressionCertTier      @relation(fields: [tierId], references: [id], onDelete: Cascade)
  reviewedBy    User?                    @relation("ProgressionCertReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, certificationId])
}

model ProgressionSkillUnlock {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  unlockedAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill ProgressionSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model ProgressionBadgeGrant {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge ProgressionBadge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

/// Control-plane record for a client hub. Does not provision DNS or a database yet.
model ClientHub {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  clientAdminEmail   String
  enabledSkuIds      String[] @default([])
  notes              String?
  dnsCnameAt         DateTime?
  railwayDomainAt    DateTime?
  tenantDbAt         DateTime?
  adminInvitedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

// ---------- Campaign automations (GHL-style trigger → email / notify) ----------
// Admins define a trigger and one or more actions. No SMS, pipelines, or
// wait/if-else trees — those stay out of v1.

enum CampaignTriggerType {
  FIRST_LOGIN
  MEMBER_JOINED
  APPLICATION_APPROVED
  TAG_ADDED
  LEVEL_REACHED
  WENT_LIVE
  INACTIVE_DAYS
  NEVER_LOGGED_IN
  DAYS_AFTER_FIRST_LOGIN
}

enum CampaignActionType {
  EMAIL
  HUB_NOTIFY
  ADMIN_NOTIFY
}

enum CampaignAudienceType {
  ALL_MEMBERS
  TAG
  GROUP
  NETWORK_TRACK
}

enum CampaignRunStatus {
  SENT
  FAILED
  SKIPPED
}

model Campaign {
  id              String               @id @default(cuid())
  name            String
  description     String?
  enabled         Boolean              @default(true)
  triggerType     CampaignTriggerType
  /// { days?: number, tagId?: string, levelId?: string }
  triggerConfig   Json                 @default("{}")
  audienceType    CampaignAudienceType @default(ALL_MEMBERS)
  audienceTagId   String?
  audienceGroupId String?
  audienceTrack   String?
  oncePerUser     Boolean              @default(true)
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  createdBy User             @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  actions   CampaignAction[]
  runs      CampaignRun[]

  @@index([enabled, triggerType])
}

model CampaignAction {
  id            String             @id @default(cuid())
  campaignId    String
  sortOrder     Int                @default(0)
  type          CampaignActionType
  emailSubject  String?
  emailBodyText String?
  notifyTitle   String?
  notifyBody    String?
  notifyHref    String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

model CampaignRun {
  id         String            @id @default(cuid())
  campaignId String
  userId     String
  triggerKey String
  status     CampaignRunStatus @default(SENT)
  error      String?
  createdAt  DateTime          @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, triggerKey])
  @@index([campaignId, createdAt])
}

model HubNotification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
