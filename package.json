{
  "name": "trifirgemediacom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:with-migrate": "prisma migrate deploy && next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "npm run guard:db && prisma db push",
    "db:migrate": "npm run guard:db && prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "npm run guard:db && tsx prisma/seed.ts",
    "db:populate-progression": "npm run guard:db && tsx scripts/populateProgression.ts",
    "db:seed-specialty-courses": "npm run guard:db && tsx scripts/seedSpecialtyCourses.ts",
    "guard:db": "tsx scripts/guardDb.ts",
    "db:backup": "tsx scripts/backupHubDb.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^3.19.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.49.0",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.1": true
  }
}
